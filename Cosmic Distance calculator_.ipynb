   "source": [
    "H_o = 70\n",
    "V_recession = float(input(\"Give the recession velocity of the object with respect to Earth(km/s):\"))\n",
    "D= (V_recession/H_o)*3260000\n",
    "print(f\" The distance of the object from Earth is: {D:,.2f} light years\")\n"
   ]
